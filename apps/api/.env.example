# Sentrix API — environment variable template.
# Copy this file to `.env` and fill in your values.
# Never commit real secrets.

# ── Application ───────────────────────────────────────────────────────────
APP_NAME=Sentrix API
APP_VERSION=0.1.0
DEBUG=false
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:3000

# ── JWT ────────────────────────────────────────────────────────────────────
# WARNING: change the secret in production — use a strong, randomly generated
#          value of at least 32 characters.
JWT_SECRET_KEY=dev-only-change-me-please-use-a-strong-secret-in-prod
JWT_ALGORITHM=HS256
JWT_ISSUER=sentrix-api
JWT_AUDIENCE=sentrix-web
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── AI Provider ────────────────────────────────────────────────────────────
# Supported values: "mock" (default, offline), "gemini" (cloud).
AI_PROVIDER=mock

# Google Gemini — only required when AI_PROVIDER=gemini.
# If the key is missing or invalid the factory falls back to mock.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ── VirusTotal ─────────────────────────────────────────────────────────────
# Threat-intelligence lookups for hashes, IPs, domains, and URLs.
# When the key is missing the VirusTotal tool reports itself unavailable.
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_BASE_URL=https://www.virustotal.com/api/v3

# ── Shodan ─────────────────────────────────────────────────────────────────
# Internet-exposure and host intelligence for IPs, domains, and hostnames.
# When the key is missing the Shodan tool reports itself unavailable.
SHODAN_API_KEY=
SHODAN_BASE_URL=https://api.shodan.io

# ── Wazuh ──────────────────────────────────────────────────────────────────
# Security-alert ingestion from a Wazuh manager via its REST API.
# WAZUH_URL is the full API base URL (e.g. https://wazuh-manager:55000).
# WAZUH_USERNAME / WAZUH_PASSWORD are Wazuh API credentials (Basic auth,
# exchanged for a JWT at /security/user/authenticate).
# When these are missing the Wazuh tool reports itself unavailable.
WAZUH_URL=
WAZUH_USERNAME=
WAZUH_PASSWORD=

# ── Seed Admin (development only) ──────────────────────────────────────────
ADMIN_EMAIL=admin@sentrix.io
ADMIN_PASSWORD=ChangeMe_123!
ADMIN_FULL_NAME=Sentrix Admin
