# ------------------------------------------------------------------
# Sentrix API — environment variables
# Copy to `.env` and fill in secret values. NEVER commit `.env`.
# ------------------------------------------------------------------

# Application
APP_NAME=Sentrix API
APP_VERSION=0.1.0
DEBUG=false
API_V1_PREFIX=/api/v1

# Security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=sentrix-api
JWT_AUDIENCE=sentrix-web

# Seed admin (used only when the in-memory repository is active)
ADMIN_EMAIL=admin@sentrix.io
ADMIN_PASSWORD=ChangeMe_123!
ADMIN_FULL_NAME=Sentrix Admin
ADMIN_ORG_ID=00000000-0000-0000-0000-000000000000

# CORS (comma-separated origins) — dev default allows the Next.js app
CORS_ORIGINS=http://localhost:3000

