# ── Sentrix API — Environment Configuration ────────────────────────────────
# Copy this file to `.env` and fill in the values.
#   cp .env.example .env
#
# Values can also be set as process environment variables; process-level
# variables take precedence over those in the `.env` file.
#
# See `app/config/settings.py` for the full list of settings.

# ── Application ────────────────────────────────────────────────────────────
APP_NAME=Sentrix API
APP_VERSION=0.1.0
DEBUG=false
ENVIRONMENT=development

# ── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:3000

# ── JWT ────────────────────────────────────────────────────────────────────
# WARNING: change the secret in production — use a strong, randomly generated
#          value of at least 32 characters.
JWT_SECRET_KEY=dev-only-change-me-please-use-a-strong-secret-in-prod
JWT_ALGORITHM=HS256
JWT_ISSUER=sentrix-api
JWT_AUDIENCE=sentrix-web
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── AI Provider ────────────────────────────────────────────────────────────
# Supported values: "mock" (default, offline), "gemini" (cloud).
AI_PROVIDER=mock

# Google Gemini — only required when AI_PROVIDER=gemini.
# If the key is missing or invalid the factory falls back to mock.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ── Seed Admin (development only) ──────────────────────────────────────────
ADMIN_EMAIL=admin@sentrix.io
ADMIN_PASSWORD=ChangeMe_123!
ADMIN_FULL_NAME=Sentrix Admin
